🔹 1. Connecting & Switching
\c dbname             -- connect to a database
\l                    -- list all databases
\dt                   -- list all tables in current database
\d tablename          -- describe table (columns, indexes, constraints)

🔹 2. Schema & Info
\dn                   -- list all schemas
\di                   -- list all indexes
\dv                   -- list all views
\d+ tablename         -- extended describe (with size, storage, etc.)


SQL alternatives:

-- list all tables in the "public" schema
SELECT tablename FROM pg_tables WHERE schemaname = 'public';

-- show indexes for a table
SELECT * FROM pg_indexes WHERE tablename = 'your_table';

🔹 3. CRUD Basics
-- Insert
INSERT INTO employees (id, name, salary) VALUES (1, 'Alice', 50000);

-- Select (all rows)
SELECT * FROM employees;

-- Select with filter
SELECT name, salary FROM employees WHERE salary > 40000;

-- Update
UPDATE employees SET salary = 60000 WHERE id = 1;

-- Delete
DELETE FROM employees WHERE id = 1;

🔹 4. Indexes
-- Create index
CREATE INDEX idx_emp_name ON employees(name);

-- See indexes of a table
\d employees

-- Drop index
DROP INDEX idx_emp_name;

🔹 5. Other Handy psql Commands
\?                    -- show all psql commands
\h                    -- help on SQL commands
\h SELECT             -- help on SELECT syntax
\q                    -- quit psql
